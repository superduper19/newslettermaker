# Server (optional)
PORT=5020
NODE_ENV=development

# AI article search & modify — use at least one
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# You.com Web Search API — Phase 1 article discovery (optional; select "You.com" in Search dropdown)
YDC_API_KEY=
# YOUCOM_FRESHNESS=week          # last 7 days (matches ARTICLE_MAX_AGE_DAYS)
# YOUCOM_SEARCH_COUNT=25         # results per section (web + news); max 100
# YOUCOM_COUNTRY=US
# YOUCOM_LANGUAGE=EN
#
# PREFER these domains (You.com boost_domains) — ranks them higher, does NOT block other sites.
# Add your cannabis publishers here (hostnames only, comma-separated):
# YOUCOM_BOOST_DOMAINS=norml.org,mjbizdaily.com,ganjapreneur.com,marijuanamoment.net,leafly.com,hempindustrydaily.com,politico.com,reuters.com,apnews.com,your-site.com
#
# Optional HARD BLOCK list (exclude_domains). Default is Wikipedia only. Add others only if you want them gone:
# YOUCOM_EXCLUDE_DOMAINS=wikipedia.org,yahoo.com,foxnews.com,pbs.org
#
# Optional STRICT mode: only search these domains (overrides boost/exclude). Use when you want news-only from your list.
# Leave empty for normal mode (boost + exclude). Example:
# YOUCOM_INCLUDE_DOMAINS=mjbizdaily.com,marijuanamoment.net,ganjapreneur.com,hempindustrydaily.com,leafly.com,norml.org,politico.com,reuters.com,apnews.com,statnews.com

# Article verify tuning (optional)
# ARTICLE_MAX_AGE_DAYS=7

# Article search tuning (optional; defaults shown)
# ARTICLE_SEARCH_MAX_WEB_USES=10
# ARTICLE_SEARCH_MAX_WEB_USES_EXTENDED=20
# ARTICLE_SEARCH_MAX_TOKENS=8000
# ARTICLE_SEARCH_MAX_TOKENS_EXTENDED=16000
# GOOGLE_API_KEY=   # alternative to GEMINI_API_KEY

# Freepik image search (optional if using upload-only)
FREEPIK_API_KEY=

# Supabase — from Dashboard: Settings → API → Project URL and API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Use the secret key for this app (server/backend). Format: sb_secret_...
# Copy from: API Keys → Secret keys → default → copy
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Or use publishable key (sb_publishable_...) if table has GRANT to anon and you prefer no secret
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: table name for app state (default: newsletter_state)
# SUPABASE_STATE_TABLE=newsletter_state

# Optional: direct Postgres connection (for scripts/drop-old-db.js only)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres

# GoDaddy FTP — article icons (upload staging; public URLs use Newsletter images/ below)
GODADDY_FTP_HOST=
GODADDY_FTP_PORT=21
GODADDY_FTP_USER=
GODADDY_FTP_PASS=
# Web root on server (stripped from public URLs)
GODADDY_FTP_WEB_ROOT=public_html
# all/, all/states/, inspirational/ live under Newsletter images (NOT News-roundup)
GODADDY_NEWSLETTER_IMAGES_FTP_PATH=Newsletter images
GODADDY_PUBLIC_BASE_URL=https://purablis.com/Newsletter%20images
# Legacy flat icons only (stanford.png): public_html/News-roundup/images/
# GODADDY_FTP_PATH=News-roundup/images
# Article images: all/ with filenames MM-DD-YY-name.png — GODADDY_ARTICLE_FTP_SUBFOLDER=all
# State icons (50): all/states/ — GODADDY_STATE_FTP_PATH=all/states
# Inspirational: inspirational/ — GODADDY_INSPIRATIONAL_FTP_PATH=inspirational
# Legacy path only used as fallback when probing reachability
# GODADDY_LEGACY_PUBLIC_BASE_URL=https://purablis.com/News-roundup/images
# Upload 50 state icons: node scripts/upload-state-icons-dark.js
# STATE_ICONS_SOURCE_DIR=C:\Users\kaveh\Documents\GitHub\bookbunnylibrary\state_icons_dark
